# ============================================================
# CuotaBabb - variables de entorno de ejemplo
# Copia este archivo como .env y cambia los valores locales.
# Nunca subas el .env real al repositorio.
# ============================================================

# --- PostgreSQL local (docker-compose) ---
DB_NAME=cuotababb
DB_USERNAME=cuotababb
DB_PASSWORD=cuotababb
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/cuotababb

# --- Backend ---
SERVER_PORT=8080
APP_BASE_URL=http://localhost:5173

# Cambia este valor por una cadena larga y aleatoria.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# Orígenes permitidos por CORS, separados por comas.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Carga los datos ficticios de la demo al arrancar.
DEMO_SEED=false

# --- Stripe (solo modo test) ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
